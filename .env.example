# n8n webhook that receives contact form enquiries as JSON:
# { name, email, phone, company, message, website, source, submittedAt }
CONTACT_WEBHOOK_URL=

# Optional. Sent as an "X-Webhook-Secret" header. In n8n, set the Webhook node's
# Authentication to "Header Auth" with name X-Webhook-Secret and this value.
CONTACT_WEBHOOK_SECRET=
